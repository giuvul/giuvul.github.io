{
  "name": "portfolio-alex-kramer",
  "version": "1.0.0",
  "description": "Sito portfolio statico in HTML, Sass e Bootstrap. Progetto del Master Start2Impact.",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/style.css --style=compressed --no-source-map",
    "watch:css": "sass --watch assets/scss/main.scss assets/css/style.css --no-source-map",
    "dev": "sass --watch assets/scss/main.scss assets/css/style.css --no-source-map",
    "vendor": "node -e \"require('fs').copyFileSync('node_modules/bootstrap/dist/css/bootstrap.min.css','assets/css/vendor/bootstrap.min.css')\""
  },
  "keywords": [
    "portfolio",
    "html",
    "sass",
    "bootstrap",
    "github-pages"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.104.1"
  },
  "private": true
}