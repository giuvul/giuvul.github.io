{
  "name": "giuvul.github.io",
  "version": "1.0.0",
  "description": "Portfolio personale di Giuseppe Vulduraro: sito statico in HTML, Sass e Bootstrap 5, senza JavaScript. Pubblicato su GitHub Pages.",
  "scripts": {
    "build:css": "sass assets/scss/main.scss assets/css/style.css --style=compressed --load-path=node_modules --quiet-deps --silence-deprecation=import --no-source-map",
    "watch:css": "sass --watch assets/scss/main.scss assets/css/style.css --load-path=node_modules --quiet-deps --silence-deprecation=import --no-source-map"
  },
  "keywords": [
    "portfolio",
    "html",
    "sass",
    "bootstrap",
    "github-pages"
  ],
  "author": "Giuseppe Vulduraro",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "bootstrap": "^5.3.3",
    "sass": "^1.104.1"
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/giuvul/giuvul.github.io.git"
  },
  "homepage": "https://giuvul.github.io/"
}
